# PostgreSQL connection string. Add ?sslmode=require for hosted databases.
DATABASE_URL=postgresql://postgres:password@localhost:5432/kahn_engine

# Required to persist OAuth sessions. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=replace_with_a_64_character_hex_key

PORT=4000
HOST=0.0.0.0

# Optional external integrations
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
